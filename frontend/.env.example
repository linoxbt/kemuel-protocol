# BOT Chain RPC URL — confirmed live via direct eth_chainId calls. Must be
# NEXT_PUBLIC_-prefixed because the wagmi config runs client-side in the
# browser bundle — an unprefixed Next.js env var would be undefined at
# runtime. (The base build spec's env var is named BOT_CHAIN_RPC_URL without
# the prefix; that name is for the /contracts and /agent workspaces, which
# read it server-side. This is the frontend's own copy.) Points at testnet
# (968) for now — flip both to mainnet (677 / rpc.botchain.ai) at Phase 7.
NEXT_PUBLIC_BOT_CHAIN_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_BOT_CHAIN_CHAIN_ID=968

# Required by RainbowKit's WalletConnect integration. Get one free at
# https://cloud.walletconnect.com. Not mentioned in the base build spec —
# needed regardless once RainbowKit is wired up.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed contract addresses. Copy these from
# contracts/deployments/<network>.json once deploy.ts has been run — the
# frontend reads addresses from env rather than importing across the
# monorepo boundary at build time.
NEXT_PUBLIC_ATTESTATION_REGISTRY_ADDRESS=
NEXT_PUBLIC_COLLATERAL_VAULT_ADDRESS=
NEXT_PUBLIC_REVENUE_BOND_VAULT_ADDRESS=
NEXT_PUBLIC_MOCK_USDT_ADDRESS=

# Base URL of the running /agent service (see agent/.env / AGENT_PORT).
NEXT_PUBLIC_AGENT_URL=http://localhost:4720
