# Kemuel Protocol — root environment variables.
# Copy to .env and fill in. Never commit .env (see .gitignore).
#
# RPC URLs — confirmed live via direct eth_chainId JSON-RPC calls (testnet
# returned 0x3c8/968, mainnet returned 0x2a5/677), cross-checked against
# DevStation's independently-verified values for the same chain.
BOT_CHAIN_TESTNET_RPC_URL=https://rpc.bohr.life
BOT_CHAIN_MAINNET_RPC_URL=https://rpc.botchain.ai
# Which network the /contracts and /agent workspaces target by default.
NETWORK=botchain-testnet
BOT_CHAIN_CHAIN_ID=968

# Dedicated hot wallets — NEVER reuse a personal/treasury key here.
# Fund both via https://faucet.botchain.ai/basic/ (testnet BOT).
DEPLOYER_PRIVATE_KEY=
ORACLE_SIGNER_PRIVATE_KEY=

# Agent service — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Stripe TEST MODE secret key only — https://dashboard.stripe.com/test/apikeys
STRIPE_TEST_SECRET_KEY=

# RainbowKit wallet-connect — https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Frontend's own copy — must be NEXT_PUBLIC_-prefixed since wagmi's config
# runs client-side in the browser bundle. Points at testnet for now.
NEXT_PUBLIC_BOT_CHAIN_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_BOT_CHAIN_CHAIN_ID=968
